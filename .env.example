# Copia este archivo a .env. Si aquí ya existe .env, no lo reemplaces:
# ahí está la cuenta de servicio. Cada línea de abajo es obligatoria.

# Reconocimiento. Subir el corte exige más parecido. El margen separa a dos personas cercanas.
COSINE_THRESHOLD=0.60
AMBIGUITY_MARGIN=0.08
FACE_SIZE=150
RECOGNITION_SECONDS=3

# Ventana de la clase, en minutos.
MINUTES_BEFORE_START=5
MINUTES_AFTER_START=30
LATE_AFTER_MINUTES=15
ON_TIME_MARGIN_MINUTES=1
COUNTDOWN_WINDOW_MINUTES=5
SCHEDULER_LOOKAHEAD_MINUTES=6

# Alta de prueba. false es el flujo real.
DEMO_MODE=false
DEMO_COURSE_ID=00000
DEMO_ID_MIN=2000000000
DEMO_ID_MAX=2999999999

# 127.0.0.1 escucha solo en esta máquina.
BFF_HOST=127.0.0.1
BFF_PORT=5000
RECOGNITION_HOST=127.0.0.1
RECOGNITION_PORT=5001

PHOTO_DIR_NAME=data
VECTOR_PATH=backend/face_vectors.json
DETECTOR_MODEL_PATH=backend/models/face_detection_yunet_2023mar.onnx
RECOGNIZER_MODEL_PATH=backend/models/face_recognition_sface_2021dec.onnx
CLASSROOM_CONFIG_FILE=classroom_config.txt
ENCRYPTION_KEY_FILE=encryption.key
ENCRYPTION_SALT_FILE=encryption_salt.key
AUDIT_LOG_FILE=audit_log.json

# JSON de la cuenta de servicio, en base64, en una sola línea.
FIREBASE_SERVICE_ACCOUNT=
