# Copia este archivo a .env. Si aquí ya existe .env, no lo reemplaces:
# ahí está la cuenta de servicio. Cada línea de abajo es obligatoria,
# salvo el nombre y las horas del evento cuando DEMO_MODE está en false.

# Reconocimiento. Subir el corte exige más parecido. El margen separa a dos personas cercanas.
COSINE_THRESHOLD=0.60
AMBIGUITY_MARGIN=0.08
FACE_SIZE=150
RECOGNITION_SECONDS=3

# Ventana de la clase, en minutos.
MINUTES_BEFORE_START=5
MINUTES_AFTER_START=30
LATE_AFTER_MINUTES=15
ON_TIME_MARGIN_MINUTES=1
COUNTDOWN_WINDOW_MINUTES=5
SCHEDULER_LOOKAHEAD_MINUTES=6

# Modo evento al arrancar. Con false el panel abre apagado y las cuatro líneas pueden ir vacías.
# Con true las cuatro son obligatorias: si falta una, el kiosco no arranca.
DEMO_MODE=false
DEMO_COURSE_ID=
DEMO_COURSE_NAME=
DEMO_INIT_TIME=
DEMO_END_TIME=

# 127.0.0.1 escucha solo en esta máquina. WIREGUARD_HOST es la dirección
# privada del túnel. Si ese adaptador no existe, el kiosco sigue en localhost.
BFF_HOST=127.0.0.1
BFF_PORT=5000
RECOGNITION_HOST=127.0.0.1
RECOGNITION_PORT=5001
WIREGUARD_HOST=10.0.0.1

# Secreto entre la página y el reconocimiento. Cámbialo en el .env real.
KIOSK_HMAC_SECRET=cambia-esta-clave
# true solo mientras se programa. Apagado, el depurador no queda activo.
KIOSK_DEBUG=false
# Si tiene valor, esa es la clave de las fotos. Vacía, sigue encryption.key.
FERNET_KEY=

PHOTO_DIR_NAME=data
DETECTOR_MODEL_PATH=app/recognition/models/face_detection_yunet_2023mar.onnx
RECOGNIZER_MODEL_PATH=app/recognition/models/face_recognition_sface_2021dec.onnx
CLASSROOM_CONFIG_FILE=classroom_config.txt
ENCRYPTION_KEY_FILE=encryption.key
ENCRYPTION_SALT_FILE=encryption_salt.key
AUDIT_LOG_FILE=audit_log.json

# JSON de la cuenta de servicio, en base64, en una sola línea.
FIREBASE_SERVICE_ACCOUNT=
